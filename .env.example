# Put these values in .env.development.local. Do not set them for production builds.
# Local authentication stays on the Bayes dev worker.
VITE_AUTH_API_BASE=http://localhost:8787
# Moderation and upload data use the Vite proxy to https://api.opendfieldmap.org.
VITE_DATA_API_BASE=/api
VITE_UGC_ASSET_BASE=https://assets.opendfieldmap.org
